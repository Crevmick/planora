PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/planora
CORS_ORIGIN=*

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_RESET_SECRET=change-me-reset-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=10m

# Hashing
BCRYPT_SALT_ROUNDS=12

# Resend Email
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Planora <onboarding@resend.dev>

# OAuth (optional, for verifying audience on mobile ID tokens)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Cloudinary (for avatar image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
